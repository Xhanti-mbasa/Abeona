{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:abeona:contracts:transit:v1",
  "title": "Abeona normalized transit contract v1",
  "type": "object",
  "required": [
    "contractVersion",
    "provider",
    "timeZone",
    "provenance",
    "routes",
    "stops",
    "schedules",
    "fares",
    "disruptions",
    "providerDetails"
  ],
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "provider": {
      "enum": [
        "PRASA",
        "MYCITI",
        "GOLDEN_ARROW"
      ]
    },
    "timeZone": {
      "const": "Africa/Johannesburg"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "stops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stop"
      }
    },
    "schedules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/schedule"
      }
    },
    "fares": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fare"
      }
    },
    "disruptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disruption"
      }
    },
    "providerDetails": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "provider",
        "kind",
        "fetchedAt",
        "publishedAt",
        "cached",
        "sourceAvailable"
      ],
      "properties": {
        "provider": {
          "enum": [
            "PRASA",
            "MYCITI",
            "GOLDEN_ARROW"
          ]
        },
        "kind": {
          "enum": [
            "scheduled",
            "live",
            "survey",
            "mixed"
          ]
        },
        "fetchedAt": {
          "type": "integer",
          "minimum": 0
        },
        "publishedAt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "expiresAt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached": {
          "type": "boolean"
        },
        "sourceAvailable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "call": {
      "type": "object",
      "required": [
        "stopId",
        "name",
        "localTime",
        "platform",
        "providerDetails"
      ],
      "properties": {
        "stopId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "localTime": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "providerDetails": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "leg": {
      "type": "object",
      "required": [
        "routeId",
        "vehicleLabel",
        "calls",
        "providerDetails"
      ],
      "properties": {
        "routeId": {
          "type": "string",
          "minLength": 1
        },
        "vehicleLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/call"
          }
        },
        "providerDetails": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": [
        "id",
        "provenance",
        "providerDetails",
        "providerId",
        "name",
        "mode",
        "stopIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "providerDetails": {
          "type": "object"
        },
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "rail",
            "bus"
          ]
        },
        "stopIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "stop": {
      "type": "object",
      "required": [
        "id",
        "provenance",
        "providerDetails",
        "providerId",
        "name",
        "point",
        "routeIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "providerDetails": {
          "type": "object"
        },
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "point": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "latitude",
                "longitude"
              ],
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "routeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "required": [
        "id",
        "provenance",
        "providerDetails",
        "serviceDate",
        "day",
        "legs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "providerDetails": {
          "type": "object"
        },
        "serviceDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "day": {
          "type": [
            "string",
            "null"
          ]
        },
        "legs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/leg"
          }
        }
      },
      "additionalProperties": false
    },
    "fare": {
      "type": "object",
      "required": [
        "id",
        "provenance",
        "providerDetails",
        "currency",
        "amountMinor",
        "product",
        "rules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "providerDetails": {
          "type": "object"
        },
        "currency": {
          "const": "ZAR"
        },
        "amountMinor": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "disruption": {
      "type": "object",
      "required": [
        "id",
        "provenance",
        "providerDetails",
        "message",
        "severity",
        "reportedAt",
        "routeIds",
        "vehicleLabels"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "providerDetails": {
          "type": "object"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "minLength": 1
        },
        "reportedAt": {
          "type": "integer",
          "minimum": 0
        },
        "routeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vehicleLabels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
