PORT=3000
NODE_ENV=development
RATE_LIMIT_RPM=60
# Optional; local memory cache remains available when Redis fails.
REDIS_URL=
# Private worker endpoint. Never expose this port through the public gateway.
SCRAPER_URL=http://127.0.0.1:8081
# Optional legacy developer utilities. Secrets never belong in the Android app.
GEMINI_API_KEY=
